# API 配置示例
# 请复制此文件为 .env 并填写你的真实 API Key

# SiliconFlow API（用于 Hunyuan-MT-7B 等模型）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 阿里云 DashScope API（用于 Qwen 等模型）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# D1 示例使用 DeepSeek 官方 API（通过 OpenAI 兼容协议，模型为 deepseek-flash）
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com

# D2 语义分块默认使用本地向量模型，无需额外 API Key。
# 此配置只控制分块阶段；seekdb 写入和检索仍使用 SDK 默认的本地向量模型。
D2_EMBEDDING_PROVIDER=local
# 如需远程向量服务，改为 api，并填写独立的 Embedding 配置：
# D2_EMBEDDING_API_KEY=your_embedding_api_key_here
# D2_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# D2_EMBEDDING_MODEL=BAAI/bge-m3

# Windows 使用已启动的本地 seekdb Server 时，取消下面配置的注释。
# SEEKDB_MODE=server
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_DATABASE=easy_data_x_ai_demo
# SEEKDB_USER=root
# SEEKDB_TENANT=sys
# SEEKDB_PASSWORD=
# 仅允许在专门的演示库中重建/清理课程集合：
# SEEKDB_ALLOW_DESTRUCTIVE=1

# D3 RAGAS 评测（可回退到上面的 SiliconFlow 配置）
# RAGAS_API_KEY=your_ragas_api_key_here
# RAGAS_BASE_URL=https://api.siliconflow.cn/v1
RAGAS_LLM_MODEL=deepseek-ai/DeepSeek-V3
RAGAS_EMBEDDING_MODEL=BAAI/bge-m3
